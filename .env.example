# Copy to .env and adjust. .env is git-ignored.
# infra/provision-entra.ps1 emits a .env.generated you can merge in.

# --- Upstream MCP server ---
# The Streamable HTTP endpoint the gateway proxies to.
UPSTREAM_MCP_URL=http://localhost:9000/mcp

# --- Gateway bind (optional) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# --- Entra auth ---
# Populated by infra/provision-entra.ps1 into .env.generated. With AUTH_ENABLED
# (the default), GATEWAY_ISSUER, GATEWAY_AUDIENCE, and GATEWAY_JWKS_URL are
# required — the gateway fails closed at boot if they're missing.
# GATEWAY_TENANT_ID=
# GATEWAY_CLIENT_ID=
# GATEWAY_AUDIENCE=        # v2 access-token aud = the app (client) id
# GATEWAY_ISSUER=          # https://login.microsoftonline.com/<tenant>/v2.0
# GATEWAY_JWKS_URL=        # https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys

# Set false to run the unauthenticated passthrough for local plumbing checks.
# AUTH_ENABLED=true

# --- RBAC + audit ---
# Group-id -> allowed-tools map (see examples/policy.example.yaml). provision-entra.ps1
# emits policy.generated.yaml with your tenant's real group object ids.
# POLICY_PATH=policy.generated.yaml
# Append-only audit log (also echoed to stdout).
# AUDIT_LOG_PATH=audit.log

# --- GitHub upstream (deploy/compose/docker-compose.github.yml) ---
# Service credential the GitHub MCP upstream uses to reach github.com. A classic
# or fine-grained PAT scoped to a THROWAWAY demo repo/org. Held inside the
# gateway's network; the user's Entra token never reaches GitHub. Required only
# when running the GitHub overlay.
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxx
# Keep the upstream itself read-only until you deliberately demo a blocked write
# (1 = read-only, 0 = allow writes so merge/delete can be exercised).
# GITHUB_READ_ONLY=1
# Narrow the exposed tool surface (comma-separated github-mcp-server toolsets).
# GITHUB_TOOLSETS=repos,issues,pull_requests

# --- MCP authorization (RFC 8707/9207/9728) ---
# Canonical resource identifier for this gateway. For Entra this is the
# Application ID URI (api://<client-id>); provision-entra.ps1 emits it into
# .env.generated. Published as the PRM `resource` field and the anchor the
# token audience is matched against. REQUIRED when AUTH_ENABLED (no default).
# GATEWAY_RESOURCE_URL=api://<client-id>
# Absolute external base URL (scheme://host[:port]) for building the 401
# `resource_metadata` pointer when behind a reverse proxy. Empty → derived from
# the incoming request origin.
# GATEWAY_EXTERNAL_BASE_URL=
# Browser origins accepted on the MCP routes besides GATEWAY_EXTERNAL_BASE_URL
# (JSON array). Any other Origin header is a 403; requests without one (every
# non-browser client) are unaffected.
# ALLOWED_ORIGINS=["https://claude.ai"]
# Scopes advertised in the PRM document (JSON array). Entra exposes
# `access_as_user`; the MCP spec's MCP.Tools.* names are illustrative.
# SCOPES_SUPPORTED=["access_as_user"]
# Authorization-server issuer published in PRM `authorization_servers`.
# Empty → falls back to GATEWAY_ISSUER (the correct Entra issuer identifier).
# ENTRA_AUTH_SERVER_METADATA_URL=
